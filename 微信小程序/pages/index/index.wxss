/* pages/index/index.wxss */

.page-container {
  padding: 32rpx;
}

/* 欢迎区域 */
.welcome-section {
  margin-bottom: 48rpx;
}

.welcome-card {
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  color: #fff;
}

.welcome-content {
  text-align: center;
  margin-bottom: 48rpx;
}

.welcome-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.welcome-subtitle {
  font-size: 36rpx;
  margin-bottom: 12rpx;
  opacity: 0.9;
}

.welcome-desc {
  font-size: 28rpx;
  opacity: 0.8;
}

.welcome-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 32rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 章节标题 */
.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #262626;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.more-btn {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 400;
}

/* 快速操作 */
.quick-actions {
  margin-bottom: 48rpx;
}

.actions-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.action-item {
  background: #fff;
  padding: 32rpx 24rpx;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.action-item:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.12);
}

.action-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.action-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #262626;
  margin-bottom: 8rpx;
}

.action-desc {
  font-size: 24rpx;
  color: #999;
}

/* 最近待办 */
.recent-todos {
  margin-bottom: 32rpx;
}

.todo-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.todo-item {
  padding: 32rpx;
  transition: all 0.3s;
}

.todo-item:active {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.todo-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.todo-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #262626;
  flex: 1;
  margin-right: 16rpx;
}

.todo-priority {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.todo-content {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.todo-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.todo-time {
  font-size: 24rpx;
  color: #999;
}

.todo-actions {
  display: flex;
  align-items: center;
}

.completed-badge {
  color: #52c41a;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background: #f6ffed;
  border-radius: 8rpx;
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  width: 100%;
  max-width: 640rpx;
  max-height: 90vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #262626;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-footer .btn {
  flex: 1;
}

/* 优先级选择 */
.priority-options {
  display: flex;
  gap: 16rpx;
}

.priority-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  border: 2rpx solid #e6e6e6;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.priority-option.active {
  border-color: #1890ff;
  background: #e6f7ff;
  color: #1890ff;
}

.priority-color {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.priority-option text {
  flex: 1;
  text-align: center;
}
