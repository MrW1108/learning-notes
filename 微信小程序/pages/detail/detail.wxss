/* pages/detail/detail.wxss */

.page-container {
  padding: 32rpx;
}

/* 详情卡片 */
.detail-card {
  padding: 48rpx 32rpx;
}

/* 头部状态区域 */
.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.todo-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.todo-status.pending {
  background: #fff7e6;
  color: #fa8c16;
}

.todo-status.completed {
  background: #f6ffed;
  color: #52c41a;
}

.status-icon {
  font-size: 32rpx;
}

.todo-priority {
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* 标题 */
.todo-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #262626;
  line-height: 1.3;
  margin-bottom: 32rpx;
  word-break: break-word;
}

.todo-title.completed {
  text-decoration: line-through;
  color: #999;
}

/* 描述 */
.todo-description {
  font-size: 32rpx;
  line-height: 1.8;
  color: #666;
  margin-bottom: 48rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.todo-description.empty {
  color: #999;
  font-style: italic;
}

/* 时间信息 */
.time-info {
  background: #fafafa;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.time-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.time-item:last-child {
  margin-bottom: 0;
}

.time-label {
  font-size: 28rpx;
  color: #999;
}

.time-value {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.button-row {
  display: flex;
  gap: 24rpx;
}

.button-row .btn {
  flex: 1;
}

/* 状态页面 */
.loading-state,
.not-found-state {
  text-align: center;
  padding: 120rpx 32rpx;
}

.loading-icon,
.not-found-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.loading-text,
.not-found-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 48rpx;
}

/* 弹窗样式（继承自全局样式） */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  width: 100%;
  max-width: 640rpx;
  max-height: 90vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #262626;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-footer .btn {
  flex: 1;
}

/* 优先级选择 */
.priority-options {
  display: flex;
  gap: 16rpx;
}

.priority-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  border: 2rpx solid #e6e6e6;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.priority-option.active {
  border-color: #1890ff;
  background: #e6f7ff;
  color: #1890ff;
}

.priority-color {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.priority-option text {
  flex: 1;
  text-align: center;
}
