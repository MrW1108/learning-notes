/* components/todo-item/todo-item.wxss */

.todo-item {
  display: flex;
  align-items: flex-start;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
  transition: all 0.3s ease;
  gap: 24rpx;
}

.todo-item:active {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.todo-item.completed {
  opacity: 0.8;
}

/* 优先级边框样式 */
.todo-item.high {
  border-left: 6rpx solid #ff4d4f;
}

.todo-item.medium {
  border-left: 6rpx solid #faad14;
}

.todo-item.low {
  border-left: 6rpx solid #52c41a;
}

/* 复选框 */
.todo-checkbox {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #d9d9d9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  flex-shrink: 0;
  margin-top: 8rpx;
  background: #fff;
}

.todo-checkbox:active {
  transform: scale(0.95);
}

.todo-checkbox.checked {
  background: #52c41a;
  border-color: #52c41a;
}

.checkbox-inner {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

/* 内容区域 */
.todo-content {
  flex: 1;
  min-width: 0;
}

.todo-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
  gap: 16rpx;
}

.todo-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #262626;
  flex: 1;
  line-height: 1.4;
  word-break: break-word;
}

.todo-title.completed-text {
  text-decoration: line-through;
  color: #999;
}

.todo-priority {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.priority-high {
  background: #fff2f0;
  color: #ff4d4f;
}

.priority-medium {
  background: #fffbe6;
  color: #faad14;
}

.priority-low {
  background: #f6ffed;
  color: #52c41a;
}

.todo-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  word-break: break-word;
}

.todo-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  gap: 16rpx;
}

.todo-time {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

.todo-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border: none;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #666;
  transition: all 0.3s ease;
}

.action-btn:active {
  opacity: 0.8;
  transform: scale(0.95);
}

.edit-btn {
  background: #e6f7ff;
  color: #1890ff;
}

.delete-btn {
  background: #fff2f0;
  color: #ff4d4f;
}

/* 响应式设计 */
@media (max-width: 400px) {
  .todo-item {
    padding: 24rpx;
  }
  
  .todo-title {
    font-size: 30rpx;
  }
  
  .todo-description {
    font-size: 26rpx;
  }
  
  .action-btn {
    padding: 10rpx 20rpx;
    font-size: 22rpx;
  }
}
